# =============================================================================
# EarnAggregator - Environment Variables Template
# =============================================================================
# ІНСТРУКЦІЯ: Скопіюйте цей файл як .env та заповніть реальними значеннями
# НЕ комітьте .env файл в Git!

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_DB=yield_db
POSTGRES_USER=yield_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://yield_user:your_secure_password_here@postgres:5432/yield_db

# =============================================================================
# Redis Cache
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Yield Data Service (FastAPI)
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# Кешування та оновлення
CACHE_EXPIRATION=3600
UPDATE_INTERVAL=3600

# Логування
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# =============================================================================
# Exchange APIs (замініть на ваші реальні ключі)
# =============================================================================

# Binance API
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_BASE_URL=https://api.binance.com

# Bybit API
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_BASE_URL=https://api.bybit.com

# OKX API (3 параметри: key, secret, passphrase)
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_API_PASSPHRASE=your_okx_passphrase_here
OKX_BASE_URL=https://www.okx.com

# Gate.io API
GATE_API_KEY=your_gate_api_key_here
GATE_API_SECRET=your_gate_api_secret_here

# Bitget API (з passphrase як в OKX)
BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_API_PASSPHRASE=your_bitget_passphrase_here

# Kraken API
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# HTX API (колишній Huobi)
HTX_API_KEY=your_htx_api_key_here
HTX_API_SECRET=your_htx_api_secret_here

# KuCoin API (3 параметри: key, secret, passphrase)
KUCOIN_API_KEY=your_kucoin_api_key_here
KUCOIN_API_SECRET=your_kucoin_api_secret_here
KUCOIN_API_PASSPHRASE=your_kucoin_passphrase_here

# =============================================================================
# Telegram Bot
# =============================================================================
BOT_TOKEN=your_telegram_bot_token_here
BOT_HOST=0.0.0.0
BOT_PORT=8081

# Внутрішня адреса для комунікації між сервісами в Docker
DATA_SERVICE_URL=http://yield-api:8000

# Публічна адреса для трекінгових посилань
# Для production замініть localhost на публічну адресу
TRACKING_REDIRECT_URL=http://localhost:8000

# =============================================================================
# Broadcast Admin Service
# =============================================================================
BROADCAST_ADMIN_API_KEY=your_broadcast_admin_api_key_here
BROADCAST_ADMIN_BASE_URL=http://localhost:8081
BROADCAST_ADMIN_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:4173"]
BROADCAST_WEB_PORT=4173
BROADCAST_QUEUE_NAME=broadcasts
BROADCAST_RATE_DELAY=0.1
BROADCAST_RETRY_BASE_DELAY=1.0
BROADCAST_RETRY_MAX_DELAY=300.0
BROADCAST_SCHEDULER_INTERVAL_SECONDS=60

# =============================================================================
# Реферальні посилання для бірж (замініть на ваші)
# =============================================================================
REFERRAL_BINANCE=https://accounts.binance.com/register?ref=YOUR_REF
REFERRAL_BYBIT=https://www.bybit.com/invite?ref=YOUR_REF
REFERRAL_OKX=https://okx.com/join/YOUR_REF
REFERRAL_MEXC=https://promote.mexc.com/r/YOUR_REF
REFERRAL_BITMART=https://www.bitmart.com/register?referralCode=YOUR_REF
REFERRAL_GATE=https://www.gate.io/signup?referralCode=YOUR_REF
REFERRAL_BITGET=https://www.bitget.com/referral/register?from=referral&clacCode=YOUR_REF
REFERRAL_KRAKEN=https://www.kraken.com/ref/YOUR_REF
REFERRAL_KUCOIN=https://www.kucoin.com/ref/YOUR_REF
REFERRAL_HTX=https://www.htx.com/ref/YOUR_REF
REFERRAL_NEXO=https://nexo.io/ref/YOUR_REF

# =============================================================================
# Трекінгові посилання для бірж (fallback)
# Замініть localhost на публічну адресу для production
# =============================================================================
TRACK_BINANCE_PAGE1=http://localhost:8000/ref?telegram_id=0&source=organic&page=1&exchange=binance&ref_code=YOUR_REF
TRACK_BINANCE_PAGE2=http://localhost:8000/ref?telegram_id=0&source=organic&page=2&exchange=binance&ref_code=YOUR_REF
TRACK_BINANCE_PAGE3=http://localhost:8000/ref?telegram_id=0&source=organic&page=3&exchange=binance&ref_code=YOUR_REF
TRACK_BYBIT_PAGE1=http://localhost:8000/ref?telegram_id=0&source=organic&page=1&exchange=bybit&ref_code=YOUR_REF
TRACK_BYBIT_PAGE2=http://localhost:8000/ref?telegram_id=0&source=organic&page=2&exchange=bybit&ref_code=YOUR_REF
TRACK_BYBIT_PAGE3=http://localhost:8000/ref?telegram_id=0&source=organic&page=3&exchange=bybit&ref_code=YOUR_REF
TRACK_OKX_PAGE1=http://localhost:8000/ref?telegram_id=0&source=organic&page=1&exchange=okx&ref_code=YOUR_REF
TRACK_OKX_PAGE2=http://localhost:8000/ref?telegram_id=0&source=organic&page=2&exchange=okx&ref_code=YOUR_REF
TRACK_OKX_PAGE3=http://localhost:8000/ref?telegram_id=0&source=organic&page=3&exchange=okx&ref_code=YOUR_REF
# ... (інші біржі за аналогією)

# =============================================================================
# Frontend (Node.js)
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BOT_URL=http://localhost:8081
FRONTEND_PORT=3000

# =============================================================================
# Docker Networks
# =============================================================================
NETWORK_NAME=earn_network
BACKEND_NETWORK=backend_net

# =============================================================================
# Development vs Production
# =============================================================================
ENVIRONMENT=development
DEBUG=true

# Для production змініть на:
# ENVIRONMENT=production
# DEBUG=false
# API_RELOAD=false

# =============================================================================
# Monitoring (опціонально)
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_SCRAPE_INTERVAL=15s

# =============================================================================
# MCP tokens (опціонально, для розробки)
# =============================================================================
# GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
# CONTEXT7_API_KEY=your_context7_key_here

